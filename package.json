{
  "name": "shaadipilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:auth:indexes": "node scripts/auth-indexes.mjs",
    "db:wedding:indexes": "node scripts/wedding-indexes.mjs",
    "db:recovery:indexes": "node scripts/recovery-indexes.mjs",
    "db:membership:indexes": "node scripts/membership-indexes.mjs",
    "design:check": "node scripts/stitch-reference.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:http": "npm run build && vitest run --config vitest.http.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "mongoose": "9.11.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
