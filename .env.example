# The app shell and build do not require service credentials.
# Copy to .env.local for local configuration; never commit real secrets.
APP_BASE_URL=http://localhost:3000

# Required only when database-backed features are invoked.
MONGODB_URI=
MONGODB_DB_NAME=shaadipilot_development

# Server-side integration settings; required only by the relevant features.
# Use separate credentials and resources for development, preview and production.
TOKEN_ENCRYPTION_KEY_ID=
TOKEN_ENCRYPTION_KEY=
GUEST_ACCESS_SIGNING_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOOGLE_PLACES_API_KEY=
# Public application policies approved by the owner; HTTPS URLs.
GOOGLE_MAPS_TERMS_URL=
GOOGLE_MAPS_PRIVACY_URL=
CRON_SECRET=
